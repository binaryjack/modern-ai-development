{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["^@turbo/cli"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["src/**/*.ts", "src/**/*.tsx"]
    }
  }
}
